# ============= TAPS =============
tap "charmbracelet/tap"  # Third-party repository
tap "zero-sh/tap"        # Third-party repository

# ============= BREWS =============
brew "bat"                   # Clone of cat(1) with syntax highlighting and Git integration
brew "btop"                  # Resource monitor. C++ version and continuation of bashtop and bpytop
brew "diff-so-fancy"         # Good-lookin' diffs with diff-highlight and more
brew "diffoscope"            # In-depth comparison of files, archives, and directories
brew "diffutils"             # File comparison utilities
brew "docker-compose"        # Isolated development environments using Docker
brew "dockutil"              # Tool for managing dock items
brew "duf"                   # Disk Usage/Free Utility - a better 'df' alternative
brew "dupseek"               # Interactive program to find and remove duplicate files
brew "exiftool"              # Perl lib for reading and writing EXIF metadata
brew "eza"                   # Modern, maintained replacement for ls
brew "fclones"               # Efficient Duplicate File Finder
brew "fd"                    # Simple, fast and user-friendly alternative to find
brew "fdupes"                # Identify or delete duplicate files
brew "ffmpeg"                # Play, record, convert, and stream select audio and video codecs
brew "findutils"             # Collection of GNU find, xargs, and locate
brew "fx"                    # Terminal JSON viewer
brew "fzf"                   # Command-line fuzzy finder written in Go
brew "gdu"                   # Disk usage analyzer with console interface written in Go
brew "gemini-cli"            # Interact with Google Gemini AI models from the command-line
brew "gh"                    # GitHub command-line tool
brew "git"                   # Distributed revision control system
brew "git-delta"             # Syntax-highlighting pager for git and diff output
brew "git-lfs"               # Git extension for versioning large files
brew "glow"                  # Render markdown on the CLI
brew "gum"                   # Tool for glamorous shell scripts
brew "handbrake"             # Open-source video transcoder available for Linux, Mac, and Windows
brew "html2markdown"         # Convert HTML to Markdown
brew "htop"                  # Improved top (interactive process viewer)
brew "hyperfine"             # Command-line benchmarking tool
brew "imagemagick"           # Tools and libraries to manipulate images in select formats
brew "jdupes"                # Duplicate file finder and an enhanced fork of 'fdupes'
brew "jq"                    # Lightweight and flexible command-line JSON processor
brew "lazygit"               # Simple terminal UI for git commands
brew "lunchy"                # Friendly wrapper for launchctl
brew "mas"                   # Mac App Store command-line interface
brew "media-info"            # Unified display of technical and tag data for audio/video
brew "mise"                  # Polyglot runtime manager (asdf rust clone)
brew "ncdu"                  # NCurses Disk Usage
brew "netlify-cli"           # Netlify command-line tool
brew "nmap"                  # Port scanning utility for large networks
brew "nnn"                   # Tiny, lightning fast, feature-packed file manager
brew "pinentry-mac"          # Pinentry for GPG on Mac
brew "rclone"                # Rsync for cloud storage
brew "rcm"                   # RC file (dotfile) management
brew "rdfind"                # Find duplicate files based on content (NOT file names)
brew "rsync"                 # Utility that provides fast incremental file transfer
brew "spaceship"             # Zsh prompt for Astronauts
brew "speedtest-cli"         # Command-line interface for https://speedtest.net bandwidth tests
brew "starship"              # Cross-shell prompt for astronauts
brew "tailscale"             # Easiest, most secure way to use WireGuard and 2FA
brew "tesseract"             # OCR (Optical Character Recognition) engine
brew "testdisk"              # Powerful free data recovery utility
brew "the_silver_searcher"   # Code-search similar to ack
brew "tmux"                  # Terminal multiplexer
brew "tree"                  # Display directories as trees (with optional color/HTML output)
brew "tz"                    # CLI time zone visualizer
brew "vim"                   # Vi 'workalike' with many additional features
brew "watchman"              # Watch files and take action when they change
brew "wget"                  # Internet file retriever
brew "yt-dlp"                # Feature-rich command-line audio/video downloader
brew "zoxide"                # Shell extension to navigate your filesystem faster
brew "zsh-completions"       # Additional completion definitions for zsh

brew "charmbracelet/tap/charm"           # The Charm Tool and Library 🌟
brew "charmbracelet/tap/melt"            # Backup and restore Ed25519 SSH keys with seed words
brew "charmbracelet/tap/skate"           # A personal key value store 🛼
brew "zero-sh/tap/apply-user-defaults"   # Small tool to set macOS user defaults from a YAML file
brew "zero-sh/tap/zero"                  # Radically simple personal bootstrapping tool for macOS

