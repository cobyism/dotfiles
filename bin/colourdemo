#!/usr/bin/env zsh

## This script demonstrates terminal color and text capabilities, including foreground and
## background colors, ANSI color and escape codes, the X11 named color set,
## text attributes, common and useful powerline/nerd font symbols,
## and their various combinations.
##
## Requires https://github.com/charmbracelet/gum for table/heading rendering.

zmodload zsh/mathfunc

command -v gum >/dev/null || {
	print -u2 "colourdemo: requires 'gum' (brew install gum)"
	exit 1
}

local cols=$(tput cols 2>/dev/null)
[[ -z $cols || $cols -eq 0 ]] && cols=${COLUMNS:-80}
[[ -z $cols || $cols -eq 0 ]] && cols=80

local sep=$'\t'

heading() {
	gum style --bold --foreground 212 --border rounded --padding '0 1' --margin '1 0' "$1"
}

table() {
	# table <columns-csv> <row> ...
	local columns=$1
	shift
	printf '%s\n' "$@" | gum table -s "$sep" -c "$columns" --border rounded --print
}

ste() {
	# ste <line> ... — each prose line must follow ASD-STE100 (Simplified Technical English)
	# rules: short sentences, active voice, imperative mood, simple approved words, one
	# instruction per line. A line starting with "$ " is a copy/pasteable example command.
	local line
	for line in "$@"; do
		if [[ $line == '$ '* ]]; then
			printf '  \e[38;5;114m%s\e[0m\n' "$line"
		else
			printf '\e[2m  %s\e[0m\n' "$line"
		fi
	done
	printf '\n'
}

show_standard_colors() {
	heading 'Standard colors (foreground / background)'
	local names=(black red green yellow blue magenta cyan white)
	local rows=()
	local i name fg bg
	for i in {0..7}; do
		name=${names[$((i + 1))]}
		fg=$((30 + i))
		bg=$((40 + i))
		rows+=("${name}${sep}\\e[${fg}m${sep}tput setaf $i${sep}$(printf '\e[%dm %s \e[0m' "$fg" "$name")${sep}\\e[${bg}m${sep}tput setab $i${sep}$(printf '\e[%dm\e[97m %s \e[0m' "$bg" "$name")")
	done
	for i in {0..7}; do
		name="bright ${names[$((i + 1))]}"
		fg=$((90 + i))
		bg=$((100 + i))
		rows+=("${name}${sep}\\e[${fg}m${sep}tput setaf $((i + 8))${sep}$(printf '\e[%dm %s \e[0m' "$fg" "$name")${sep}\\e[${bg}m${sep}tput setab $((i + 8))${sep}$(printf '\e[%dm\e[30m %s \e[0m' "$bg" "$name")")
	done
	table 'name,fg escape,fg tput,fg swatch,bg escape,bg tput,bg swatch' "${rows[@]}"
	ste 'Type "tput setaf N" to set the text color.' \
		'Type "tput setab N" to set the background color.' \
		'N is a number from 0 to 15.' \
		'Type "tput sgr0" to remove the color.' \
		'$ tput setaf 2; echo "Hello"; tput sgr0'
}

show_256_colors() {
	heading '256-color palette (0-15 standard, 16-231 color cube, 232-255 grayscale)'
	local i
	for i in {0..15}; do
		printf '\e[38;5;%dm%4d\e[0m' "$i" "$i"
	done
	printf '\n\n'
	for i in {16..231}; do
		printf '\e[38;5;%dm%4d\e[0m' "$i" "$i"
		((((i - 16) + 1) % 36 == 0)) && printf '\n'
	done
	printf '\n\n'
	for i in {232..255}; do
		printf '\e[38;5;%dm%4d\e[0m' "$i" "$i"
		((((i - 232) + 1) % 12 == 0)) && printf '\n'
	done
	printf '\n'
	ste 'Type "\e[38;5;Nm" to set the text color.' \
		'Type "\e[48;5;Nm" to set the background color.' \
		'N is a number from 0 to 255.' \
		'Type "\e[0m" to remove the color.' \
		'Type "tput colors" to check that your terminal supports 256 colors.' \
		'$ printf "\e[38;5;208mHello\e[0m\n"'
}

show_truecolor() {
	heading '24-bit truecolor gradient'
	local width=$((cols - 2))
	local i r g b
	for ((i = 0; i < width; i++)); do
		r=$(( int(sin(i / 20.0 + 0) * 127 + 128) ))
		g=$(( int(sin(i / 20.0 + 2) * 127 + 128) ))
		b=$(( int(sin(i / 20.0 + 4) * 127 + 128) ))
		printf '\e[48;2;%d;%d;%dm \e[0m' "$r" "$g" "$b"
	done
	printf '\n'
	ste 'Type "\e[38;2;R;G;Bm" to set an exact text color.' \
		'Type "\e[48;2;R;G;Bm" to set an exact background color.' \
		'R, G, and B are numbers from 0 to 255.' \
		'Set COLORTERM to "truecolor" before you run your script.' \
		'$ printf "\e[38;2;30;144;255mHello\e[0m\n"'
}

show_truecolor_vertical() {
	heading '24-bit truecolor gradient (vertical, annotated)'
	local width=$((cols - 2))
	local rows=32
	local block=4
	local i col r g b hex
	for ((i = 0; i < rows; i++)); do
		col=$((i * width / rows))
		r=$(( int(sin(col / 20.0 + 0) * 127 + 128) ))
		g=$(( int(sin(col / 20.0 + 2) * 127 + 128) ))
		b=$(( int(sin(col / 20.0 + 4) * 127 + 128) ))
		hex=$(printf '%02X%02X%02X' "$r" "$g" "$b")
		printf '\e[48;2;%d;%d;%dm%*s\e[0m  ' "$r" "$g" "$b" "$block" ''
		printf '#%s   rgb(%3d,%3d,%3d)   bg \\e[48;2;%d;%d;%dm   fg \\e[38;2;%d;%d;%dm\n' \
			"$hex" "$r" "$g" "$b" "$r" "$g" "$b" "$r" "$g" "$b"
	done
	printf '\n'
	ste 'Read the R, G, B values next to a color block.' \
		'Copy the escape code shown next to that color.' \
		'Paste the code into your script to use that exact color.' \
		'$ printf "\e[48;2;30;144;255m \e[0m\n"'
}

show_text_attributes() {
	heading 'Text attributes'
	local attrs=(
		'1:Bold'
		'2:Dim'
		'3:Italic'
		'4:Underline'
		'9:Strikethrough'
		'7:Reverse'
		'5:Blink'
	)
	local rows=()
	local pair code name
	for pair in "${attrs[@]}"; do
		code=${pair%%:*}
		name=${pair##*:}
		rows+=("${name}${sep}\\e[${code}m${sep}$(printf '\e[%sm the quick fox \e[0m' "$code")")
	done
	table 'attribute,escape,demo' "${rows[@]}"
	ste 'Type "\e[1m" to make text bold.' \
		'Type "\e[4m" to underline text.' \
		'You can join codes with a semicolon. Type "\e[1;4m" for bold, underlined text.' \
		'Type "\e[0m" to remove all attributes.' \
		'$ printf "\e[1;4mBold underline\e[0m\n"'
}

show_nerd_font_glyphs() {
	heading 'Common powerline / nerd font glyphs'
	local glyphs=(
		'Powerline right (solid): '
		'Powerline left (solid): '
		'Powerline right (thin): '
		'Powerline left (thin): '
		'Git branch: '
		'GitHub: '
		'Folder: '
		'Terminal: '
		'Gear: '
		'Lock: '
		'Home: '
		'Check: ✔'
		'Cross: ✘'
	)
	local rows=()
	local pair name glyph
	for pair in "${glyphs[@]}"; do
		name=${pair%%: *}
		glyph=${pair##*: }
		rows+=("${name}${sep}${glyph}")
	done
	table 'name,glyph' "${rows[@]}"
	ste 'Install a Nerd Font on your system.' \
		'Select the Nerd Font in your terminal settings.' \
		'Copy the glyph character into your prompt or script.' \
		'The terminal shows an empty box if the font is missing.' \
		'$ printf " main\n"'
}

sub_heading() {
	printf '\e[1;4;38;5;250m%s\e[0m\n' "$1"
}

show_x11_colors() {
	heading 'X11 named colors (grouped per Wikipedia: Web colors § X11 color names)'
	# Groups and ordering match https://en.wikipedia.org/wiki/Web_colors#X11_color_names
	local entries=(
		'@@Pink colors'
		'MediumVioletRed:C71585' 'DeepPink:FF1493' 'PaleVioletRed:DB7093'
		'HotPink:FF69B4' 'LightPink:FFB6C1' 'Pink:FFC0CB'
		'@@Red colors'
		'DarkRed:8B0000' 'Red:FF0000' 'Firebrick:B22222' 'Crimson:DC143C'
		'IndianRed:CD5C5C' 'LightCoral:F08080' 'Salmon:FA8072'
		'DarkSalmon:E9967A' 'LightSalmon:FFA07A'
		'@@Orange colors'
		'OrangeRed:FF4500' 'Tomato:FF6347' 'DarkOrange:FF8C00' 'Coral:FF7F50'
		'Orange:FFA500'
		'@@Yellow colors'
		'DarkKhaki:BDB76B' 'Gold:FFD700' 'Khaki:F0E68C' 'PeachPuff:FFDAB9'
		'Yellow:FFFF00' 'PaleGoldenrod:EEE8AA' 'Moccasin:FFE4B5'
		'PapayaWhip:FFEFD5' 'LightGoldenrodYellow:FAFAD2' 'LemonChiffon:FFFACD'
		'LightYellow:FFFFE0'
		'@@Brown colors'
		'Maroon:800000' 'Brown:A52A2A' 'SaddleBrown:8B4513' 'Sienna:A0522D'
		'Chocolate:D2691E' 'DarkGoldenrod:B8860B' 'Peru:CD853F' 'RosyBrown:BC8F8F'
		'Goldenrod:DAA520' 'SandyBrown:F4A460' 'Tan:D2B48C' 'Burlywood:DEB887'
		'Wheat:F5DEB3' 'NavajoWhite:FFDEAD' 'Bisque:FFE4C4' 'BlanchedAlmond:FFEBCD'
		'Cornsilk:FFF8DC'
		'@@Purple, violet, and magenta colors'
		'Indigo:4B0082' 'Purple:800080' 'DarkMagenta:8B008B' 'DarkViolet:9400D3'
		'DarkSlateBlue:483D8B' 'BlueViolet:8A2BE2' 'DarkOrchid:9932CC' 'Fuchsia:FF00FF'
		'Magenta:FF00FF' 'SlateBlue:6A5ACD' 'MediumSlateBlue:7B68EE' 'MediumOrchid:BA55D3'
		'MediumPurple:9370DB' 'Orchid:DA70D6' 'Violet:EE82EE' 'Plum:DDA0DD'
		'Thistle:D8BFD8' 'Lavender:E6E6FA'
		'@@Blue colors'
		'MidnightBlue:191970' 'Navy:000080' 'DarkBlue:00008B' 'MediumBlue:0000CD'
		'Blue:0000FF' 'RoyalBlue:4169E1' 'SteelBlue:4682B4' 'DodgerBlue:1E90FF'
		'DeepSkyBlue:00BFFF' 'CornflowerBlue:6495ED' 'SkyBlue:87CEEB' 'LightSkyBlue:87CEFA'
		'LightSteelBlue:B0C4DE' 'LightBlue:ADD8E6' 'PowderBlue:B0E0E6'
		'@@Cyan colors'
		'Teal:008080' 'DarkCyan:008B8B' 'LightSeaGreen:20B2AA' 'CadetBlue:5F9EA0'
		'DarkTurquoise:00CED1' 'MediumTurquoise:48D1CC' 'Turquoise:40E0D0' 'Aqua:00FFFF'
		'Cyan:00FFFF' 'Aquamarine:7FFFD4' 'PaleTurquoise:AFEEEE' 'LightCyan:E0FFFF'
		'@@Green colors'
		'DarkGreen:006400' 'Green:008000' 'DarkOliveGreen:556B2F' 'ForestGreen:228B22'
		'SeaGreen:2E8B57' 'Olive:808000' 'OliveDrab:6B8E23' 'MediumSeaGreen:3CB371'
		'LimeGreen:32CD32' 'Lime:00FF00' 'SpringGreen:00FF7F' 'MediumSpringGreen:00FA9A'
		'DarkSeaGreen:8FBC8F' 'MediumAquamarine:66CDAA' 'YellowGreen:9ACD32' 'LawnGreen:7CFC00'
		'Chartreuse:7FFF00' 'LightGreen:90EE90' 'GreenYellow:ADFF2F' 'PaleGreen:98FB98'
		'@@White colors'
		'MistyRose:FFE4E1' 'AntiqueWhite:FAEBD7' 'Linen:FAF0E6' 'Beige:F5F5DC'
		'WhiteSmoke:F5F5F5' 'LavenderBlush:FFF0F5' 'OldLace:FDF5E6' 'AliceBlue:F0F8FF'
		'Seashell:FFF5EE' 'GhostWhite:F8F8FF' 'Honeydew:F0FFF0' 'FloralWhite:FFFAF0'
		'Azure:F0FFFF' 'MintCream:F5FFFA' 'Snow:FFFAFA' 'Ivory:FFFFF0' 'White:FFFFFF'
		'@@Gray and black colors'
		'Black:000000' 'DarkSlateGray:2F4F4F' 'DimGray:696969' 'SlateGray:708090'
		'Gray:808080' 'LightSlateGray:778899' 'DarkGray:A9A9A9' 'Silver:C0C0C0'
		'LightGray:D3D3D3' 'Gainsboro:DCDCDC'
	)
	local entry name hex r g b lum fg maxlen
	local members=()
	local first=1

	flush_group() {
		((${#members[@]})) || return
		maxlen=0
		local m n
		for m in "${members[@]}"; do
			n=${m%%:*}
			((${#n} > maxlen)) && maxlen=${#n}
		done
		local rows=()
		for m in "${members[@]}"; do
			n=${m%%:*}
			hex=${m##*:}
			r=$((16#${hex[1,2]}))
			g=$((16#${hex[3,4]}))
			b=$((16#${hex[5,6]}))
			lum=$(((r * 299 + g * 587 + b * 114) / 1000))
			fg=$((lum > 140 ? 30 : 97))
			rows+=("$(printf '\e[48;2;%d;%d;%dm\e[%dm %-*s \e[0m' "$r" "$g" "$b" "$fg" "$maxlen" "$n")${sep}#${hex}${sep}rgb(${r}, ${g}, ${b})${sep}\\e[38;2;${r};${g};${b}m${sep}\\e[48;2;${r};${g};${b}m")
		done
		table 'swatch,hex,rgb,fg escape,bg escape' "${rows[@]}"
	}

	for entry in "${entries[@]}"; do
		if [[ $entry == '@@'* ]]; then
			((first)) || flush_group
			first=0
			sub_heading "${entry#@@}"
			members=()
			continue
		fi
		members+=("$entry")
	done
	flush_group
	ste 'An X11 name has no escape code of its own.' \
		'Look up the hex value for the name first.' \
		'Split the hex value into three parts: red, green, and blue.' \
		'Use these three numbers in a truecolor escape code.' \
		'$ hex=1E90FF; printf "\e[48;2;%d;%d;%dm \e[0m\n" $((16#${hex:0:2})) $((16#${hex:2:2})) $((16#${hex:4:2}))'
}

show_combinations() {
	heading 'Combinations (mock prompt segments)'
	printf '\e[48;5;24m\e[97m\e[1m ~/code/dotfiles \e[0m'
	printf '\e[38;5;24m\e[48;5;238m\e[0m'
	printf '\e[48;5;238m\e[97m  main \e[0m'
	printf '\e[38;5;238m\e[49m\e[0m\n'

	printf '\e[48;5;22m\e[97m\e[1m  OK \e[0m'
	printf '\e[38;5;22m\e[49m\e[0m'
	printf '  \e[1;38;5;208mzsh\e[0m %% \n'
	ste 'Set a background color, then a text color. Then print your text.' \
		'Set the text color to match the last background color.' \
		'Print the separator glyph. This joins two segments with one clean line.' \
		'Prompt tools such as starship and p10k use this method.' \
		'$ printf "\e[48;5;24m\e[97m Segment \e[0m\e[38;5;24m\uE0B0\e[0m\n"'
}

show_standard_colors
show_256_colors
show_truecolor
show_truecolor_vertical
show_x11_colors
show_text_attributes
show_nerd_font_glyphs
show_combinations
