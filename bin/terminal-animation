#!/usr/bin/env zsh

## terminal-animation — Learn how terminal output updates/animation work.
##
## Subcommands:
##   progress [--width N]     Single-line progress bar (0-100%)
##   spinner [--duration N]   Animated spinner on one line
##   multiline [--items N]    Multiple lines updating independently, with progress

emulate -L zsh
setopt pipe_fail extended_glob

# The escape sequences we'll use throughout.
# Each one is documented where it's used, but here's a quick reference:
#
#   \e = ESC character (same as \033 or $'\e')
#   \e[H = move cursor to top-left (1,1)
#   \e[row;colH = move cursor to specific row, col (1-indexed)
#   \e[K = erase from cursor to end of line
#   \e[2J = erase entire screen
#   \e[?25l = hide cursor
#   \e[?25h = show cursor
#   \r = carriage return (move to start of line, no newline)
#
# The key insight: \r overwrites the current line without advancing.
# Escape sequences don't use \r — they move the cursor absolutely or clear regions.

usage() {
	sed -n '2,/^$/p' "$0" | sed 's/^## \{0,1\}//'
}

# ─────────────────────────────────────────────────────────────────────────────
# PROGRESS BAR — one line that updates in place with \r
# ─────────────────────────────────────────────────────────────────────────────

cmd_progress() {
	local width=${1:-40}
	local total=100
	local i filled empty percent bar

	printf 'Building %-40s   0%%\r' ''
	fflush

	for ((i = 1; i <= total; i++)); do
		# Calculate how many characters are "filled" vs "empty"
		filled=$(( (i * width) / total ))
		empty=$(( width - filled ))

		# Build the bar: [████░░░░░░]
		bar="["
		bar+=$(printf '%*s' "$filled" '' | tr ' ' '█')
		bar+=$(printf '%*s' "$empty" '' | tr ' ' '░')
		bar+="]"
		percent=$(( (i * 100) / total ))

		# \r at the START: move cursor to beginning of line.
		# This overwrites what we printed before, no newline.
		# %40s pads text to 40 chars (for label that might shrink).
		printf '%s   %3d%%\r' "$bar" "$percent"
		fflush

		# Small sleep to see the animation (remove for real usage)
		sleep 0.02
	done

	# Final state: erase the \r buffer, print the completed bar on its own line
	printf '%s   %3d%%\n' "$bar" 100
}

# ─────────────────────────────────────────────────────────────────────────────
# SPINNER — animated frames cycling on one line
# ─────────────────────────────────────────────────────────────────────────────

cmd_spinner() {
	local duration=${1:-5}  # seconds
	local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
	local start=$(date +%s)
	local elapsed=0
	local i=0
	local frame

	# Hide cursor so spinning doesn't show a blinking cursor
	printf '\e[?25l'
	trap 'printf "\e[?25h"; trap - RETURN' RETURN

	printf 'Spinning..\r'
	fflush

	while ((elapsed < duration)); do
		frame=${frames[$((i % ${#frames[@]} + 1))]}
		# \r overwrites the line. The frame cycles through the array.
		# We could add a label, e.g. "Installing ${frame} "
		printf 'Processing %s\r' "$frame"
		fflush

		sleep 0.08  # ~12 fps
		((i++))

		elapsed=$(( $(date +%s) - start ))
	done

	# When done, overwrite the spinner and show final state
	printf 'Processing ✔\n'
}

# ─────────────────────────────────────────────────────────────────────────────
# MULTILINE — multiple independent lines updating in place
# ─────────────────────────────────────────────────────────────────────────────

cmd_multiline() {
	local num_items=${1:-4}
	local total_steps=20

	# Print initial state: one line per item, with cursor at the end.
	# We need to remember where each line is so we can update it later.
	local i
	for ((i = 1; i <= num_items; i++)); do
		printf 'Item %d: [%-20s]   0%%\n' "$i" ''
	done

	# Hide cursor so updates don't show a blinking cursor
	printf '\e[?25l'
	trap 'printf "\e[?25h"; trap - RETURN' RETURN

	# Now iterate: on each step, move cursor to each line, overwrite it.
	local step filled empty percent bar
	for ((step = 1; step <= total_steps; step++)); do
		for ((i = 1; i <= num_items; i++)); do
			# \e[H is "cursor home" (1,1).
			# \e[row;colH moves to row, col (1-indexed).
			# We need to move to the row of item i.
			# item 1 is on row 1, item 2 on row 2, etc.
			# BUT: we printed the initial items, so they're already num_items rows down
			# from where we started. Let's use relative movement:
			# \e[A = up one line, \e[B = down one line
			#
			# Easier approach: calculate absolute position.
			# After printing num_items lines, cursor is at row (num_items + 1).
			# Item i is on row i.
			# So we move to row i.
			# Actually, we're trying to overwrite lines we just printed.
			# Let's use:  \e[Num_items A to go back to the top of our block,
			# then \e[(i-1)B to go down i-1 lines.
			#
			# Simpler: after first iteration, we're always within our block.
			# Use: \e[row;colH to go to absolute position.
			# But we need to know which row. Let's just track it.

			# Actually, the simplest approach:
			# 1. Print initial lines (1 per item)
			# 2. Move cursor up by (num_items - i + 1) to get to item i's line
			# 3. Print the update
			# 4. Move cursor down to where we were
			#
			# But we're in a loop. Better approach:
			# Use \e[row;1H to move to column 1 of row i, then overwrite.
			# The row numbers: item 1 is on the first line printed, etc.
			# After the initial printf loop, cursor is at row (num_items + 1), col 1.
			# So item i is on row i.

			local row=$i

			# \e[row;colH: move cursor to row, col (1-indexed, from top of screen)
			printf '\e[%d;1H' "$row"

			# Calculate progress for this item (varies to show independent updates)
			filled=$(( (step * 20 + i * 50) / 100 ))
			empty=$(( 20 - filled ))
			bar="["
			bar+=$(printf '%*s' "$filled" '' | tr ' ' '█')
			bar+=$(printf '%*s' "$empty" '' | tr ' ' '░')
			bar+="]"
			percent=$(( (step * 100) / total_steps ))

			# \e[K erases from cursor to end of line, clearing any old content
			printf 'Item %d: %s   %3d%%\e[K' "$i" "$bar" "$percent"
			fflush
		done

		sleep 0.05
	done

	# Move cursor to the end (below all items) and show final state
	local final_row=$((num_items + 1))
	printf '\e[%d;1H' "$final_row"
	printf 'Done.\n'
}

# ─────────────────────────────────────────────────────────────────────────────
# Main dispatch
# ─────────────────────────────────────────────────────────────────────────────

case ${1:-} in
	progress)
		cmd_progress "${2:-40}"
		;;
	spinner)
		cmd_spinner "${2:-5}"
		;;
	multiline)
		cmd_multiline "${2:-4}"
		;;
	'')
		usage
		exit 1
		;;
	*)
		printf 'Unknown command: %s\n' "$1" >&2
		usage >&2
		exit 1
		;;
esac
