#!/usr/bin/env zsh

# External subcommand for `brew`:
# Maintains an up-to-date Brewfile in $DOTFILES.

# $DOTFILES/Brewfile is a symlink to $DOTFILES/homebrew/Brewfile.sorted, which is generated by this script.

# Step 1: Generate $DOTFILES/homebrew/Brewfile.raw using `brew bundle dump`
# Step 2: Sort $DOTFILES/homebrew/Brewfile.raw into $DOTFILES/homebrew/Brewfile.sorted using `brewfile-sort`
# Step 3: Symlink $DOTFILES/homebrew/Brewfile.sorted to $DOTFILES/Brewfile

# Paths
local BREWFILE_DIR="$HOME/code/dotfiles/homebrew"
local BREWFILE_ARCHIVE="$BREWFILE_DIR/archived"
local BREWFILE_SYMLINK="$HOME/code/dotfiles/Brewfile"
local BREWFILE_RAW="$BREWFILE_DIR/Brewfile.raw"
local BREWFILE_SORTED="$BREWFILE_DIR/Brewfile.sorted"

abort() {
  echo "!!! $*" >&2
  exit 1
}

gum style --bold --padding "1 1" "Decants current homebrew items (taps, casks, formulae, mas, fonts, vscode extensions) into a pretty Brewfile."
gum confirm && : || abort "Fine."

# Function to handle intelligent file backups
backup_if_changed() {
	local file="$1"

	# Extract filename and directory
	local filename="${file:t}"  # tail (basename)
	local filedir="${file:h}"   # head (dirname)

	# Find most recent backup (files with timestamp prefix)
	# Pattern: YYYY-MM-DD_HH-MM-SS_filename
	local most_recent_backup
	most_recent_backup=$(ls -t "$BREWFILE_ARCHIVE"/*"-${filename}" 2>/dev/null | head -n 1)

	if [[ -z "$most_recent_backup" ]]; then
		echo "No existing backup found for '$filename'"
		# Optionally create initial backup here:
		local timestamp=$(date +%Y%m%d-%H%M%S)
		cp "$file" "$BREWFILE_ARCHIVE/${timestamp}-${filename}"
		echo "Created initial backup: ${timestamp}-${filename}"
		return 0
	fi

	# echo "Found most recent backup: ${most_recent_backup:t}"

	# Compare files (binary safe, silent)
	if cmp -s "$file" "$most_recent_backup"; then
		gum log --level debug "✓ ${file:t} identical to most recent backup ${most_recent_backup:t} - discarding current file…"
		rm "$file"
	else
		local timestamp=$(date +%Y%m%d-%H%M%S)
		local backup_name="${BREWFILE_ARCHIVE}/${timestamp}-${filename}"
		gum log --level debug "✗ ${file:t} has changed since ${most_recent_backup:t} - creating backup at ${backup_name:t}…"
		mv "$file" "$backup_name"
		# echo "Backed up: $file → ${backup_name:t}"
	fi
}

# Remove current linkable and home symlink
gum log --level info "Refreshing Brewfile…"
if [ -L "$BREWFILE_SYMLINK" ]; then
	rm -f "$BREWFILE_SYMLINK"
fi
if [ -e "$BREWFILE_RAW" ]; then
	backup_if_changed $BREWFILE_RAW
fi
if [ -e "$BREWFILE_SORTED" ]; then
	backup_if_changed $BREWFILE_SORTED
fi

# Regenerate linkable
# echo "Generating new Brewfile…"
gum spin -s pulse --title "Generating new Brewfile…" -- brew bundle dump --all --describe --force --file=$BREWFILE_RAW
gum log --level info "Brewfile generated!"

# Sort the Brewfile using the brewfile-sort script
# echo "Sorting Brewfile and making it all neat and tidy…"
gum spin -s pulse --title "Sorting, tidying, making it pop…" -- $HOME/code/dotfiles/bin/brewfile-sort $BREWFILE_RAW > $BREWFILE_SORTED
gum log --level info "Sorting and tidying complete!"

# # Add first line to the file with a quick info block and generated timestamp
# # First output a quick info block, with generated timestamp
# echo "# Brewfile generated with brewfile-sort on $(date +"%Y-%m-%d") at $(date +"%H:%M:%S") ^_^"
# echo ""

# echo "Linking sorted Brewfile to global location…"
# Link the sorted Brewfile to the global Brewfile location
gum spin -s pulse --title "Linking Brewfile into global location…" -- ln -sf $BREWFILE_SORTED $BREWFILE_SYMLINK
gum log --level info "Brewfile linked into global location!"

# Done!
gum style --border="rounded" --foreground="#0FF" --border-foreground="#00F" --padding "0 1" --bold "Ah, that’s better!"
# echo "Ah, that's better!"