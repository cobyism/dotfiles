#!/usr/bin/env zsh

# git-scan.zsh
# Scans subdirectories of the current directory and reports their git status

# ── Colours ──────────────────────────────────────────────────────────────────
autoload -U colors && colors

C_RESET=$'\e[0m'
C_BOLD=$'\e[1m'
C_DIM=$'\e[2m'
C_RED=$'\e[31m'
C_GREEN=$'\e[32m'
C_YELLOW=$'\e[33m'
C_CYAN=$'\e[36m'
C_MAGENTA=$'\e[35m'
C_BLUE=$'\e[34m'
C_WHITE=$'\e[37m'
C_GREY=$'\e[90m'

# ── Helpers ───────────────────────────────────────────────────────────────────
tag()  { print -n "  ${C_DIM}[${C_RESET}${1}${C_DIM}]${C_RESET}" }
nl()   { print "" }
hr()   { print "${C_GREY}$(printf '─%.0s' {1..60})${C_RESET}" }

# ── Per-repo analysis ─────────────────────────────────────────────────────────
analyse_repo() {
  local dir="$1"
  local tags=()
  local notes=()

  # Move into repo
  builtin cd "$dir" || return

  # ── Has any commits? ──────────────────────────────────────────────────────
  local has_commits=false
  if git rev-parse HEAD &>/dev/null; then
    has_commits=true
  fi

  if ! $has_commits; then
    tags+=("${C_YELLOW}EMPTY${C_RESET}")
    print_repo "$dir" tags notes
    return
  fi

  # ── Branch info ───────────────────────────────────────────────────────────
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)

  # ── Remotes ───────────────────────────────────────────────────────────────
  local remotes
  remotes=($(git remote 2>/dev/null))

  if (( ${#remotes} == 0 )); then
    tags+=("${C_MAGENTA}LOCAL-ONLY${C_RESET}")
  else
    tags+=("${C_BLUE}remote:${remotes[1]}${C_RESET}")
    (( ${#remotes} > 1 )) && tags+=("${C_BLUE}+$((${#remotes}-1)) more${C_RESET}")
  fi

  # ── Ahead / behind remote ─────────────────────────────────────────────────
  if (( ${#remotes} > 0 )); then
    local upstream
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)

    if [[ -n "$upstream" ]]; then
      local ahead behind
      ahead=$(git rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)
      behind=$(git rev-list --count "HEAD..${upstream}" 2>/dev/null || echo 0)

      if (( ahead == 0 && behind == 0 )); then
        tags+=("${C_GREEN}synced${C_RESET}")
      else
        (( ahead  > 0 )) && tags+=("${C_YELLOW}↑${ahead} unpushed${C_RESET}")
        (( behind > 0 )) && tags+=("${C_RED}↓${behind} behind${C_RESET}")
      fi
    else
      tags+=("${C_GREY}no upstream${C_RESET}")
    fi
  fi

  # ── Working tree & index ──────────────────────────────────────────────────
  local status_output
  status_output=$(git status --porcelain 2>/dev/null)

  local staged=0 unstaged=0 untracked=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local xy="${line:0:2}"
    local index_char="${xy:0:1}"
    local worktree_char="${xy:1:1}"

    [[ "$index_char"   != " " && "$index_char"   != "?" ]] && (( staged++ ))
    [[ "$worktree_char" != " " && "$worktree_char" != "?" ]] && (( unstaged++ ))
    [[ "$xy" == "??" ]] && (( untracked++ ))
  done <<< "$status_output"

  (( staged    > 0 )) && tags+=("${C_YELLOW}${staged} staged${C_RESET}")
  (( unstaged  > 0 )) && tags+=("${C_RED}${unstaged} unstaged${C_RESET}")
  (( untracked > 0 )) && tags+=("${C_GREY}${untracked} untracked${C_RESET}")

  if (( staged == 0 && unstaged == 0 && untracked == 0 )); then
    # Only add "clean" if we haven't already shown sync status
    [[ ${#remotes} == 0 ]] && tags+=("${C_GREEN}clean${C_RESET}")
  fi

  # ── Stashes ───────────────────────────────────────────────────────────────
  local stash_count
  stash_count=$(git stash list 2>/dev/null | wc -l | tr -d ' ')
  (( stash_count > 0 )) && tags+=("${C_CYAN}${stash_count} stash${C_RESET}")

  # ── Rebase / merge / cherry-pick in progress? ─────────────────────────────
  local git_dir
  git_dir=$(git rev-parse --git-dir 2>/dev/null)
  [[ -f "${git_dir}/MERGE_HEAD"       ]] && tags+=("${C_RED}MERGING${C_RESET}")
  [[ -f "${git_dir}/rebase-merge/head" || -d "${git_dir}/rebase-apply" ]] && tags+=("${C_RED}REBASING${C_RESET}")
  [[ -f "${git_dir}/CHERRY_PICK_HEAD" ]] && tags+=("${C_RED}CHERRY-PICK${C_RESET}")
  [[ -f "${git_dir}/BISECT_LOG"       ]] && tags+=("${C_YELLOW}BISECTING${C_RESET}")

  print_repo "$dir" "$branch" tags notes
}

# ── Print one repo line ───────────────────────────────────────────────────────
print_repo() {
  local dir="$1"
  local branch="$2"
  local -a t=("${(@P)3}")

  local tag_str=""
  for t in "${t[@]}"; do
    tag_str+="  ${C_DIM}[${C_RESET}${t}${C_DIM}]${C_RESET}"
  done

  local branch_str=""
  [[ -n "$branch" ]] && branch_str="${C_GREY} (${branch})${C_RESET}"

  printf "  ${C_BOLD}${C_WHITE}%-36s${C_RESET}${branch_str}${tag_str}\n" "$dir"
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
  local scan_dir="${1:-.}"
  scan_dir="${scan_dir:A}"   # resolve to absolute path

  print ""
  print "${C_BOLD}${C_CYAN}Git Repository Scanner${C_RESET}  ${C_GREY}→ ${scan_dir}${C_RESET}"
  hr

  local git_dirs=()
  local non_git_dirs=()
  local saved_dir="$PWD"

  # Collect all immediate subdirectories (non-hidden)
  local entries=( "$scan_dir"/*(N/DN) )   # N = nullglob, D = dotglob off, / = dirs only

  if (( ${#entries} == 0 )); then
    print "  ${C_GREY}No subdirectories found.${C_RESET}"
    print ""
    return
  fi

  for entry in "${entries[@]}"; do
    local name="${entry:t}"
    if [[ -d "${entry}/.git" ]] || git -C "$entry" rev-parse --git-dir &>/dev/null 2>&1; then
      git_dirs+=("$entry")
    else
      non_git_dirs+=("$name")
    fi
  done

  # ── Git repos ─────────────────────────────────────────────────────────────
  if (( ${#git_dirs} > 0 )); then
    print ""
    print "  ${C_BOLD}Git repositories${C_RESET}  ${C_GREY}(${#git_dirs})${C_RESET}"
    print ""

    for repo in "${git_dirs[@]}"; do
      local name="${repo:t}"
      analyse_repo "$repo"
      builtin cd "$saved_dir"
    done
  fi

  # ── Non-git dirs ──────────────────────────────────────────────────────────
  if (( ${#non_git_dirs} > 0 )); then
    print ""
    hr
    print ""
    print "  ${C_BOLD}Not git repositories${C_RESET}  ${C_GREY}(${#non_git_dirs})${C_RESET}"
    print ""
    for name in "${non_git_dirs[@]}"; do
      printf "  ${C_GREY}%-36s${C_RESET}\n" "$name"
    done
  fi

  print ""
  hr
  print "  ${C_GREY}Scanned ${#entries} directories.  $(date '+%Y-%m-%d %H:%M:%S')${C_RESET}"
  print ""
}

main "$@"