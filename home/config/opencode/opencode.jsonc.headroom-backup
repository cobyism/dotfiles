{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "turbo-fieldfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Turbo Fieldfare",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "gemma-4-26b-a4b-it": {
          "maxTokens": 4096,
          "contextWindow": 16384,
        },
      },
    },
    "lmstudio2": {
      "name": "LmStudio2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:1234/v1",
      },
      "models": {
        "google/gemma-4-26b-a4b": {
          "name": "Gemma 4 26B A4B",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "systemPrompt": "Keep responses to the point. One step at a time.",
        },
        "google/gemma-4-e2b": {
          "name": "Gemma 4 E2B",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "systemPrompt": "Keep responses to the point. One step at a time.",
        },
        "google/gemma-4-e4b": {
          "name": "Gemma 4 E4B",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "systemPrompt": "Keep responses to the point. One step at a time.",
        },
      },
    },
  },
}
