// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview_font_size": 21.0,
  "markdown_preview": {
    "limit_content_width": false
  },
  "cli_default_open_behavior": "new_window",
  "ui_font_family": "Geist",
  "markdown_preview_code_font_family": "Monaspace Krypton NF",
  "markdown_preview_font_family": "Geist",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 100.0,
  "buffer_font_family": "Monaspace Neon NF",
  "redact_private_values": true,
  "use_system_path_prompts": true,
  "accessible_mode": true,
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "group_by": "staging",
    "dock": "left"
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "theme": "Dracula",
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "use_modifier_to_send": true,
    "thinking_display": "preview",
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "enable_feedback": false,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "dock": "left",
    "default_model": {
      "effort": "medium",
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0
}
