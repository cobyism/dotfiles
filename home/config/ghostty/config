font-family = "Monaspace Neon NF"
font-family-bold = "Monaspace Neon NF"
font-family-italic = "Monaspace Radon NF"
font-family-bold-italic = "Monaspace Radon NF"
font-size = 12
font-feature = +calt,+liga,+ss01,+ss02,+ss03,+ss04,+ss05,+ss06,+ss08,+ss09,+ss10
#font-family = "Geist Mono"
#font-family-bold = "Geist Mono Bold"
#font-family-italic = "Geist Mono Italic"
#font-family-bold-italic = "Geist Mono Bold Italic"

window-title-font-family = "Geist Pixel"

theme = "Neobones Dark"
# Oxocarbon, Argonaut, Framer, iTerm2 Tanko Dark, Purple Rain, Wez

split-divider-color = "#c00"

window-padding-x = 20
window-padding-y = 20

# macos-titlebar-style = hidden
macos-titlebar-style = tabs

shell-integration = detect
shell-integration-features = cursor,title,sudo,path,ssh-env,ssh-terminfo

window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true
window-new-tab-position = end

bell-features = border,title,attention,system
app-notifications = clipboard-copy,config-reload

macos-window-buttons = visible
macos-titlebar-style = transparent
window-show-tab-bar = always
macos-window-shadow = false

#background-image = ~/Pictures/cc-wallpaper/wallpaper-ipad/Awe_Dropping_iPad_Gradient.png
#background-image-opacity = 0.05
#background-image-fit = cover

background-opacity = 1
background-opacity-cells = true
background-blur = 0

cursor-color = "#FF0000"
cursor-click-to-move = true
link-previews = true

# keybind = global:cmd+shift+ctrl+opt+backquote=toggle_quick_terminal
keybind = global:cmd+shift+ctrl+opt+backquote=toggle_quick_terminal

#custom-shader = ~/code/ghostty-cursor-shaders/cursor_warp.glsl
