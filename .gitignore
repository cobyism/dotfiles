*~
**/.DS_Store
**/Thumbs.db
**/.svn
**/.hg
**/CVS
**/.swp
**/.sass-cache
**/.env
**/.localrc
**/.vscode
**/update-notifier*.json
**/extensions/*
**/keypairs/*
config/iterm2/AppSupport
config/.mono
config/gh/hosts.yml
config/raycast
config/rclone
config/sonic-pi.net
config/SweetScape
config/Xplist
config/yarn
config/gatsby/*

# op CLI - device-specific state, not a shareable preference
config/op/*

# crush/goose - skill symlinks resolve outside this repo
config/crush/skills

# uv - installer receipt, machine-specific
config/uv/*

# darktable - SQLite library/cache databases, corruption-prone to sync
config/darktable/*

# herdr - ephemeral session/log state and bundled asset
config/herdr/session.json
config/herdr/session-history.json
config/herdr/*.log
config/herdr/.plugins.lock
config/herdr/release-notes.json

# zed - binary prompt library DB, not portable/sync-safe
config/zed/prompts/

# fizzy - config.yaml contains a live API token
config/fizzy/

config/tmux/*.local

# regenerated fresh by script/bootstrap on every run - see that script
resources/chezmoi-config.toml
resources/chezmoistate.boltdb
