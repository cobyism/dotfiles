*~
**/.DS_Store
**/Thumbs.db
**/.svn
**/.hg
**/CVS
**/.swp
**/.sass-cache
**/.env
**/.localrc
**/.vscode
**/.mise.toml
**/.claude/settings.local.json

**/update-notifier*.json
**/extensions/*
**/keypairs/*
home/config/iterm2/AppSupport
home/config/.mono
home/config/gh/hosts.yml
home/config/raycast
home/config/rclone
home/config/sonic-pi.net
home/config/SweetScape
home/config/Xplist
home/config/yarn
home/config/gatsby/*

# op CLI - device-specific state, not a shareable preference
home/config/op/*

# crush/goose - skill symlinks resolve outside this repo
home/config/crush/skills

# uv - installer receipt, machine-specific
home/config/uv/*

# darktable - SQLite library/cache databases, corruption-prone to sync
home/config/darktable/*

# herdr - ephemeral session/log state and bundled asset
home/config/herdr/session.json
home/config/herdr/session-history.json
home/config/herdr/*.log
home/config/herdr/.plugins.lock
home/config/herdr/release-notes.json

# zed - binary prompt library DB, not portable/sync-safe
home/config/zed/prompts/

# fizzy - config.yaml contains a live API token
home/config/fizzy/

home/config/tmux/*.local

.serena/
home/config/openspec/
