#!/usr/bin/env zsh
set -e

## Variables

HOME="$HOME"
DOTFILES="$HOME/.dotfiles"

## Utilities

# Check if a command exists and is available in PATH, with helpful messages and exit codes.
function check_command() {
	local cmd="$1"
	if command -v "$cmd" &> /dev/null; then
		echo "✅ '$cmd' command is installed and available in your \$PATH."
	else
		echo "🚨 Error: '$cmd' is not installed or not available in PATH. Please install '$cmd' and ensure it's in your PATH before running this script." >&2
		exit 1
	fi
}

# Check if homebrew formula/cask is installed, with helpful messages and exit codes.
function check_brew_package() {
	local pkg="$1"
	if brew list --formula | grep -q "^$pkg\$" || brew list --cask | grep -q "^$pkg\$"; then
		echo "✅ Homebrew package '$pkg' is installed."
	else
		echo "🚨 Error: Homebrew package '$pkg' is not installed. Please install it (e.g., via 'brew install $pkg') before running this script." >&2
		exit 1
	fi
}

# Check multiple homebrew packages at once
function check_brew_packages() {
	local pkgs=("$@")
	for pkg in "${pkgs[@]}"; do
		check_brew_package "$pkg"
	done
}

# Function to check for "lastrun" file for a given concern to see if ever has been run.
function check_if_run() {
	local concern="$1"
	local lastrun_file="$DOTFILES/home/config/dotfiles/.lastrun_$concern"
	if [ -f "$lastrun_file" ]; then
		echo "✅ '$concern' has been run before (lastrun file exists)."
	else
		echo "⚠️ '$concern' has never been run before (lastrun file does not exist)."
	fi
}

# Function to create or update "lastrun" file for a given concern to mark that it has been run.
function mark_ran() {
	local concern="$1"
	local lastrun_dir="$DOTFILES/home/config/dotfiles"
	mkdir -p "$lastrun_dir"
	local lastrun_file="$lastrun_dir/.lastrun_$concern"
	touch "$lastrun_file"
	echo "Marked '$concern' as having been run (updated lastrun file)."
}

