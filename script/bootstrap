#!/usr/bin/env zsh


#
# Manual/non-brew installation of stuff
# Particle CLI $ bash <( curl -sL https://particle.io/install-cli )
# Claude Code?

# Assumes this repo is cloned into ~/code/dotfiles
local DOTFILES_REPO="$HOME/code/dotfiles"

# check if ~/.dotfiles is a symlink and if it is, remove it
if [ -L ~/.dotfiles ]; then
  echo "Removing ~/.dotfiles symlink"
  rm ~/.dotfiles
fi

echo "Linking ${DOTFILES_REPO} as ~/.dotfiles"
ln -swi $DOTFILES_REPO ~/.dotfiles

# ~/Brewfile is kept as a plain symlink outside chezmoi's management, since
# bin/brew-decant regenerates and re-symlinks $DOTFILES_REPO/Brewfile on every
# run; chezmoi managing it as a copied file would go stale between runs.
if [ -L ~/Brewfile ]; then
  echo "Removing ~/Brewfile symlink"
  rm ~/Brewfile
fi
echo "Linking ${DOTFILES_REPO}/Brewfile as ~/Brewfile"
ln -swi $DOTFILES_REPO/Brewfile ~/Brewfile

# Next up: ensure brew installed, install chezmoi, rest of Brewfile, etc.

# Check if chezmoi is installed
if ! command -v chezmoi &> /dev/null; then
  echo "chezmoi could not be found. Please install it (e.g., via Homebrew: brew install chezmoi) and run this script again."
  exit 1
fi

CHEZMOI_CONFIG="$DOTFILES_REPO/resources/chezmoi-config.toml"

# Regenerated fresh each run so it's correct for wherever $DOTFILES_REPO
# actually resolves to on this machine, rather than trusting a committed
# absolute path from whichever machine last wrote it.
echo "sourceDir = \"$DOTFILES_REPO\"" > "$CHEZMOI_CONFIG"

echo "Initializing chezmoi against ${DOTFILES_REPO}..."
chezmoi --config "$CHEZMOI_CONFIG" init --source="$DOTFILES_REPO"
echo "Applying chezmoi to symlink dotfiles into place..."
chezmoi --config "$CHEZMOI_CONFIG" apply -v